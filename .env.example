# Copy this file to .env on your server and fill in the real values there.
# Never commit real API keys to the browser app or to Git.

# Optional. Set this before public deployment to prevent strangers from
# calling your server-side model keys. The browser can send it as
# Authorization: Bearer <token>; locally you may leave it empty.
MANUSCRIPT_API_TOKEN=

# Required for Vercel or other serverless deployments if you want persistent
# conversations and memories. Locally you may leave it empty to use data/db.json.
DATABASE_URL=

# Optional SSRF protection for custom models. Leave empty for broad HTTPS
# custom endpoints, or set a comma-separated hostname allowlist such as:
# api.openai.com,api.deepseek.com,token-plan-cn.xiaomimimo.com
ALLOWED_CUSTOM_ENDPOINT_HOSTS=

DEEPSEEK_V4_PRO_ENDPOINT=
DEEPSEEK_V4_PRO_API_KEY=
DEEPSEEK_V4_PRO_MODEL=deepseek-reasoner
DEEPSEEK_V4_PRO_REASONING_MODEL=deepseek-reasoner

MIMO_V2_5_PRO_ENDPOINT=https://token-plan-cn.xiaomimimo.com/v1
MIMO_V2_5_PRO_API_KEYS=
MIMO_V2_5_PRO_MODEL=mimo-v2.5-pro

GPT_5_4_ENDPOINT=https://api.apikey.fun
GPT_5_4_API_KEY=
GPT_5_4_MODEL=gpt-5.4

CLAUDE_OPUS_4_6_ENDPOINT=https://api.apikey.fun
CLAUDE_OPUS_4_6_API_KEY=
CLAUDE_OPUS_4_6_MODEL=claude-opus-4-6

GEMINI_ENDPOINT=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-pro

# Example custom node. In the UI, use CUSTOM_OPENAI as the server env prefix.
# CUSTOM_OPENAI_ENDPOINT=https://api.openai.com
# CUSTOM_OPENAI_API_KEY=
# CUSTOM_OPENAI_API_KEYS=
# CUSTOM_OPENAI_MODEL=
